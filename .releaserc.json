{
	"branches": [ "master" ],
	"plugins": [
		[
			"@semantic-release/commit-analyzer",
			{ "preset": "conventionalcommits" }
		],
		[
			"@semantic-release/release-notes-generator",
			{ "preset": "conventionalcommits" }
		],
		[
			"@semantic-release/github",
			{
				"draftRelease": true,
				"successCommentCondition": false,
				"failCommentCondition": false,
				"labels": false,
				"releasedLabels": false,
				"addReleases": false,
				"assets": [
					{
						"path": "release/aggressive-ads-*.zip",
						"label": "Aggressive Ads Plugin"
					},
					{
						"path": "release/aggressive-ads-*.zip.sha256",
						"label": "Aggressive Ads Plugin SHA-256"
					}
				]
			}
		]
	]
}
