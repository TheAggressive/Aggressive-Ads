# Dependencies — never committed, never shipped.
# vendor/ is dev tooling only; it never ships.
/vendor/

# The WordPress suites' own PHPUnit 9.6, installed by bin/ci/install-wp-runner.sh.
# Its composer.json and composer.lock are tracked; the packages are not.
/tests/wp/vendor/
/node_modules/

# Build output
/dist/
/build/
/.pnpm-store/

# Release artifacts
/release/
*.zip
*.zip.sha256

# Tooling caches
/.cache/
/.phpunit.cache/
/.phpunit.result.cache
/.phpcs-cache
/.eslintcache
/coverage/
/test-results/
/.playwright-results/
/playwright-report/

# Compiled translations are built at package time, not committed.
# The .pot and every .po ARE committed — they are the source translators work
# from, and the drift gate diffs against the committed .pot.
/languages/*.mo
/languages/*.l10n.php
/languages/*.json
/languages/.drift.pot

# An accidental nested WordPress copy, never part of the plugin.
/wp-content/

# Local environment
.env
.env.local

# Editors and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# Claude Code: this one file only.
#
# settings.local.json is per-machine state — permissions someone approved on
# their own laptop — and belongs to nobody else. Everything else under
# .claude/ is shared knowledge that must stay in version control: a skill
# describing how to drive this plugin is documentation, and reviewable.
#
# Ignoring the whole `.claude/` directory is the trap. The sibling Aggressive
# Apparel theme does exactly that, and the consequence is that its `verify`
# skill exists only on one developer's disk — untracked, unreviewed, and lost
# with the checkout. Keep this narrow.
.claude/settings.local.json
/release/
build/test-results/
