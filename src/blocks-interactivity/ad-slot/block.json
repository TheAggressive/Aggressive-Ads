{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "aggr/ad-slot",
	"version": "1.5.0",
	"title": "Ad Slot",
	"category": "widgets",
	"icon": "megaphone",
	"description": "A reserved slot filled at request time, optionally rotating. Editors place a slot, never a campaign.",
	"keywords": [
		"ad",
		"advertising",
		"slot",
		"rotate",
		"banner"
	],
	"textdomain": "aggressive-ads",
	"attributes": {
		"slot": {
			"type": "string",
			"default": ""
		},
		"rotate": {
			"type": "boolean",
			"default": false
		},
		"rotateSeconds": {
			"type": "number",
			"default": 10
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [
			"left",
			"center",
			"right",
			"wide",
			"full"
		],
		"color": {
			"background": true,
			"text": false
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"width": true,
			"style": true
		},
		"interactivity": true
	},
	"editorScript": "file:./index.js",
	"editorStyle": "file:./index.css",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js"
}
