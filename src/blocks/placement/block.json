{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "aggr/placement",
	"version": "1.0.0",
	"title": "Ad placement",
	"category": "widgets",
	"icon": "megaphone",
	"description": "A reserved slot filled at request time. Editors place a slot, never a campaign.",
	"keywords": [ "ad", "advertising", "placement", "slot" ],
	"textdomain": "aggressive-ads",
	"attributes": {
		"slot": {
			"type": "string",
			"default": ""
		}
	},
	"supports": {
		"html": false,
		"anchor": true,
		"align": [ "left", "center", "right", "wide", "full" ],
		"color": {
			"background": true,
			"text": false
		},
		"spacing": {
			"margin": true,
			"padding": true
		},
		"__experimentalBorder": {
			"color": true,
			"radius": true,
			"width": true,
			"style": true
		}
	},
	"editorScript": "file:./index.js",
	"style": "file:./style-index.css",
	"viewScriptModule": "file:./view.js"
}
