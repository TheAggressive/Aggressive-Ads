# PHPStan configuration
#
# Level 8, no baseline, no ignoreErrors. A baseline is a list of known problems
# you have agreed to stop looking at, and it only grows. See
# docs/build-and-release.md.
#
# The plugin ships without vendor/, so the runtime autoloader is
# LAAO_Advertiser_Portal\Autoloader; the bootstrap file below defines the
# constants WordPress would have defined by the time any of this code runs.

parameters:
	level: 8
	paths:
		- inc
		- laao-advertiser-portal.php
		# Runs with full privileges, outside the bootstrap, and deletes things.
		- uninstall.php

	bootstrapFiles:
		- tests/php/phpstan-bootstrap.php

	scanFiles:
		- vendor/php-stubs/wordpress-stubs/wordpress-stubs.php

	# Matches the composer platform constraint.
	phpVersion: 80400

	# WordPress stubs declare optimistic types: a docblock may say a filter
	# returns array<int,int>, but any plugin can make it return anything at
	# runtime. PHPStan 2 trusts those docblocks as certain, which reports every
	# defensive is_string()/is_array() guard as redundant — and acting on that
	# would delete protection real runtime paths depend on.
	treatPhpDocTypesAsCertain: false

	# Universal object crates — allow dynamic properties on these classes.
	universalObjectCratesClasses:
		- WP_Post
		- WP_Term
		- WP_User
		- WP_Comment
		- WP_Query
		- stdClass
