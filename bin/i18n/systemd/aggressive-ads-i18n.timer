[Unit]
Description=Aggressive Ads: translation draft, while the machine is on

[Timer]
# Deliberately not a wall-clock schedule. This machine is off overnight, so an
# OnCalendar=03:00 timer with Persistent=true does the opposite of what it
# looks like: it skips every night and then fires the moment you boot, taking
# the GPU while you are sitting down to work.
#
# So the trigger is "the machine is on and has been for a while" instead.
OnBootSec=20min
OnUnitActiveSec=3h

# Enough to miss the login rush and whatever else starts with the session.
RandomizedDelaySec=10m

# Nothing to catch up on: there is no missed occurrence when the schedule is
# relative to boot rather than to a clock.
Persistent=false

[Install]
WantedBy=timers.target
