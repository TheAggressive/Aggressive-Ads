# Copy to `.env.local` (gitignored) for local i18n machine translation.
#
#   cp .env.example .env.local
#
# Translation runs on a model you host, so there is nothing here CI can use and
# no key to leak. Read by bin/i18n/lib.sh, which parses KEY=value rather than
# sourcing this file — a dotenv should not be able to run shell. Anything
# already set in the environment wins over this file.

# Local model: any OpenAI-compatible server (LM Studio, Ollama, llama.cpp).
# The base URL ends at /v1; the run calls {URL}/chat/completions at temperature
# 0, and checks {URL}/models for the model before touching any catalog.
# CI cannot reach a model on your machine, so this is a local-only provider.
# I18N_LOCAL_URL=http://localhost:1234/v1
# I18N_LOCAL_MODEL=qwen/qwen3.8-27b
# Optional: sent as a Bearer token for servers that require one.
# I18N_LOCAL_API_KEY=
# Optional: per-string timeout in milliseconds (reasoning models are slow).
# I18N_LOCAL_TIMEOUT_MS=180000
# Optional: pause between requests. Zero is right for a model on your own
# network; it exists for metered APIs.
# I18N_MT_DELAY_MS=0
