# Copy to `.env.local` (gitignored) for local i18n machine translation.
# Never commit real keys. CI uses GitHub Actions secrets instead.
#
#   cp .env.example .env.local
#
# Read by bin/i18n/lib.sh, which parses KEY=value rather than sourcing this
# file — a dotenv holding an API key should not be able to run shell.
# Anything already set in the environment wins, so CI secrets are never
# shadowed by a stale local copy.

# Recommended DeepL API key (free-tier keys end with `:fx`).
# The primary provider. Without it, MT falls back to MyMemory, which is
# noticeably rougher on short UI labels — and this plugin's catalog is mostly
# short UI labels.
DEEPL_AUTH_KEY=

# auto (default: DeepL first, MyMemory fallback) | mymemory | deepl (no fallback)
# I18N_MT_PROVIDER=auto

# Optional: raises the MyMemory daily character quota (fallback path only).
# I18N_MT_EMAIL=you@example.com

# Optional: delay between MT requests, in milliseconds.
# I18N_MT_DELAY_MS=350
