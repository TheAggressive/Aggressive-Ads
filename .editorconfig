# https://editorconfig.org
# WordPress Coding Standards: tabs for indentation, everywhere except the
# formats whose own ecosystems mandate spaces.
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = tab
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yml,yaml,md}]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.neon]
indent_style = tab

[composer.json]
indent_style = tab
