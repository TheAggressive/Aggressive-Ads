<?xml version="1.0"?>
<!--
	The suites that need real WordPress and a real database.

	Separate from phpunit.xml.dist because PHPUnit allows exactly one bootstrap
	per configuration file, and the unit suite must not load WordPress while
	these must. See docs/testing-strategy.md.

	Run with: pnpm test:php:integration
-->
<phpunit
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
	bootstrap="tests/php/bootstrap-wp.php"
	colors="true"
	beStrictAboutTestsThatDoNotTestAnything="true"
	convertDeprecationsToExceptions="true"
	failOnWarning="true"
	failOnRisky="true"
	failOnSkipped="true"
	failOnIncomplete="true"
	cacheResultFile=".phpunit.cache/integration.result"
	>
	<extensions>
		<!--
			Empties this plugin's tables before every test.

			`WP_UnitTestCase` rolls each test back, and that covers these tables
			too — until a test performs DDL, which implicitly commits the
			transaction and makes everything written after it permanent. See
			tests/php/Plugin_Table_Reset.php for what that cost twice.
		-->
		<extension class="Aggressive\Ads\Tests\Plugin_Table_Reset"/>
	</extensions>

	<php>
		<env name="WP_PHPUNIT__TESTS_CONFIG" value="/var/www/html/wp-content/plugins/aggressive-ads/tests/wp-tests-config.php"/>
	</php>
	<testsuites>
		<testsuite name="integration">
			<directory suffix="Test.php">tests/php/Integration</directory>
		</testsuite>
		<testsuite name="security">
			<directory suffix="Test.php">tests/php/Security</directory>
		</testsuite>
		<testsuite name="rest">
			<directory suffix="Test.php">tests/php/Rest</directory>
		</testsuite>
		<testsuite name="upgrade">
			<directory suffix="Test.php">tests/php/Upgrade</directory>
		</testsuite>
	</testsuites>

	<coverage>
		<include>
			<directory suffix=".php">inc</directory>
		</include>
	</coverage>
</phpunit>
