{
	"name": "aggressive-ads",
	"version": "0.0.0-development",
	"description": "Live means live. White-label advertising management for WordPress.",
	"license": "GPL-2.0-or-later",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24 <25",
		"pnpm": ">=11 <12"
	},
	"packageManager": "pnpm@11.1.2",
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@eslint/js": "^9.39.5",
		"@fontsource-variable/archivo": "^5.3.0",
		"@playwright/test": "^1.62.1",
		"@semantic-release/github": "^12.0.9",
		"@types/jest": "^30.0.0",
		"@types/node": "^20.17.10",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@wordpress/api-fetch": "^7.53.0",
		"@wordpress/browserslist-config": "^6.53.0",
		"@wordpress/components": "^39.0.0",
		"@wordpress/dataviews": "^18.0.0",
		"@wordpress/dependency-extraction-webpack-plugin": "6.53.0",
		"@wordpress/element": "^8.5.0",
		"@wordpress/i18n": "^6.26.0",
		"@wordpress/interactivity": "^6.53.0",
		"@wordpress/prettier-config": "^4.53.0",
		"@wordpress/scripts": "^34.1.0",
		"@wordpress/stylelint-config": "^24.2.0",
		"@wordpress/url": "^4.53.0",
		"concurrently": "^9.2.4",
		"conventional-changelog-conventionalcommits": "^10.2.1",
		"eslint": "^9.39.5",
		"eslint-plugin-react": "^7.37.5",
		"eslint-plugin-react-hooks": "^7.1.1",
		"fast-glob": "^3.3.3",
		"husky": "^9.1.7",
		"jest-environment-jsdom": "30.4.1",
		"lint-staged": "^16.2.7",
		"mini-css-extract-plugin": "^2.10.2",
		"prettier": "npm:wp-prettier@^3.0.3",
		"semantic-release": "^25.0.8",
		"stylelint": "^16.24.0",
		"typescript": "^5.9.3",
		"webpack-merge": "^6.0.1",
		"webpack-remove-empty-scripts": "^1.0.4"
	},
	"scripts": {
		"prepare": "husky",
		"env:start": "bash bin/ci/retry.sh 3 bash bin/ci/environment.sh start",
		"env:stop": "bash bin/ci/environment.sh stop",
		"env:logs": "bash bin/ci/environment.sh logs",
		"cli": "bash bin/ci/environment.sh wp",
		"build": "rm -rf dist && pnpm build:modules && pnpm build:assets && pnpm build:blocks && pnpm build:admin",
		"build:modules": "wp-scripts build --config webpack.modules.config.mjs",
		"build:assets": "wp-scripts build --config webpack.assets.config.mjs",
		"build:blocks": "wp-scripts build --webpack-src-dir=./src/blocks --output-path=./dist/blocks --experimental-modules",
		"build:admin": "pnpm build:dataviews && wp-scripts build --config webpack.admin.config.mjs && node bin/ci/check-admin-bundle.mjs",
		"start": "concurrently -k -n modules,assets,blocks -c blue,magenta,green \"pnpm start:modules\" \"pnpm start:assets\" \"pnpm start:blocks\"",
		"start:modules": "wp-scripts start --config webpack.modules.config.mjs",
		"start:assets": "wp-scripts start --config webpack.assets.config.mjs",
		"start:blocks": "wp-scripts start --webpack-src-dir=./src/blocks --output-path=./dist/blocks --experimental-modules",
		"format:fix": "prettier --write \"src/**/*.{js,json,ts,tsx}\" \"tests/e2e/**/*.{js,json,ts,tsx}\" \"bin/**/*.mjs\" \"*.config.{js,mjs,ts}\" package.json tsconfig.json",
		"format:check": "prettier --check \"src/**/*.{js,json,ts,tsx}\" \"tests/e2e/**/*.{js,json,ts,tsx}\" \"bin/**/*.mjs\" \"*.config.{js,mjs,ts}\" package.json tsconfig.json",
		"lint:js": "eslint src --max-warnings 0",
		"lint:js:fix": "eslint src --fix",
		"lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
		"lint:css:fix": "stylelint \"src/**/*.css\" --fix",
		"lint:commit": "commitlint --edit",
		"typecheck": "tsc --noEmit",
		"test:js": "wp-scripts test-unit-js --config jest.config.js",
		"lint:php": "composer run-script phpcs",
		"lint:php:fix": "composer run-script phpcs:fix",
		"i18n": "bash bin/i18n/all.sh",
		"i18n:pot": "bash bin/i18n/pot.sh",
		"i18n:sync": "bash bin/i18n/sync.sh",
		"i18n:compile": "bash bin/i18n/compile.sh",
		"i18n:status": "bash bin/i18n/status.sh",
		"i18n:check": "bash bin/i18n/check.sh",
		"i18n:locale": "bash bin/i18n/locale.sh",
		"i18n:translate": "bash bin/i18n/translate.sh",
		"dev:seed": "pnpm cli -- eval 'require \"/var/www/html/wp-content/plugins/aggressive-ads/bin/dev/seed.php\";'",
		"analyse:php": "composer run-script analyse",
		"lint:workflows": "bash bin/ci/lint-workflows.sh",
		"lint:shell": "bash bin/check-shell.sh",
		"test:tools": "node --test bin/release/version-contract.test.mjs bin/ci/check-coverage.test.mjs bin/ci/check-navigation.test.mjs bin/ci/check-admin-bundle.test.mjs bin/ci/check-rewrite-version.test.mjs bin/i18n/lint-placeholders.test.mjs bin/ci/summary-rules.test.mjs bin/load/evaluate.test.mjs bin/load/mixed-view.test.mjs",
		"version:sync": "node bin/release/sync-version.mjs",
		"lint:files": "php bin/ci/check-rewrite-version.php && node bin/ci/check-version-contract.mjs && node bin/ci/check-suppression-reasons.mjs && node bin/ci/check-styles.mjs && node bin/ci/check-navigation.mjs && bash bin/check-file-length.sh && bash bin/ci/check-repository-boundary.sh && bash bin/ci/check-permission-callbacks.sh && bash bin/ci/check-action-pins.sh && bash bin/ci/check-ci-parity.sh",
		"test:php:unit": "vendor/bin/phpunit",
		"test:php:integration": "bash bin/ci/run-wp-tests.sh phpunit-integration.xml.dist",
		"test:php:multisite": "bash bin/ci/run-wp-tests.sh phpunit-multisite.xml.dist",
		"test:php:native": "bash bin/local/wp-tests.sh",
		"test:php:native:integration": "bash bin/local/wp-tests.sh phpunit-integration.xml.dist",
		"test:php:native:multisite": "bash bin/local/wp-tests.sh phpunit-multisite.xml.dist",
		"db:local": "bash bin/local/mysql.sh",
		"test:e2e:install": "bash bin/ci/retry.sh 2 playwright install --with-deps chromium webkit",
		"test:e2e:install:chromium": "bash bin/ci/retry.sh 2 playwright install --with-deps chromium",
		"test:e2e:browsers": "playwright install chromium webkit",
		"test:e2e": "playwright test",
		"test:load": "node bin/load/run.mjs",
		"test:e2e:studio": "bash bin/local/studio-e2e.sh",
		"ci:doctor": "node bin/ci/doctor.mjs",
		"ci:coverage": "bash bin/ci/run-coverage.sh",
		"ci:security": "node bin/ci/check-patched-dependencies.mjs && composer audit --locked --no-interaction && composer audit --locked --no-interaction --working-dir=tests/wp && pnpm audit --audit-level moderate --ignore GHSA-xcpc-8h2w-3j85",
		"ci:build": "pnpm build",
		"composer:verify": "composer validate --strict --no-check-publish && composer install --dry-run --no-interaction --no-scripts && composer validate --strict --no-check-publish --working-dir=tests/wp && composer install --dry-run --no-interaction --no-scripts --working-dir=tests/wp",
		"ci:frontend": "pnpm lint:js && pnpm typecheck && pnpm lint:css && pnpm format:check && pnpm lint:shell && pnpm test:tools && pnpm test:js",
		"ci:i18n": "bash bin/ci/i18n.sh",
		"ci:php": "pnpm lint:php && pnpm analyse:php && pnpm test:php:unit",
		"ci:php:wp": "pnpm test:php:multisite",
		"ci:php:forward": "pnpm ci:doctor && bash bin/ci/php-forward.sh",
		"ci:e2e": "pnpm test:e2e",
		"release:package": "bash bin/release/package.sh",
		"release:verify": "bash bin/release/verify-package.sh",
		"ci:package": "bash bin/ci/package.sh",
		"ci:artifact": "pnpm ci:doctor && bash bin/ci/artifact.sh",
		"qa": "pnpm ci:verify",
		"qa:lanes": "node bin/ci/lanes.mjs",
		"qa:fresh": "pnpm env:stop && pnpm env:start && pnpm ci:verify",
		"qa:fast": "bash bin/ci/verify-fast.sh",
		"qa:local": "bash bin/local/verify.sh",
		"precommit": "lint-staged",
		"ci:verify": "bash bin/ci/verify.sh",
		"build:dataviews": "wp-scripts build --config webpack.dataviews.config.mjs"
	},
	"lint-staged": {
		"src/**/*.{js,ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		],
		"src/**/*.css": "stylelint --fix",
		"tests/e2e/**/*.{js,ts,tsx}": "prettier --write",
		"bin/**/*.mjs": "prettier --write",
		"{package.json,tsconfig.json,*.config.js,*.config.mjs,*.config.ts}": "prettier --write"
	},
	"pnpm": {
		"ignoredBuiltDependencies": [
			"@parcel/watcher",
			"core-js",
			"core-js-pure",
			"unrs-resolver"
		]
	}
}
