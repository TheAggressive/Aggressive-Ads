{
	"name": "aggressive-ads",
	"version": "0.1.0",
	"description": "Live means live. White-label advertising management for WordPress.",
	"license": "GPL-2.0-or-later",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24 <25",
		"pnpm": ">=11 <12"
	},
	"packageManager": "pnpm@11.1.2",
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"devDependencies": {
		"@axe-core/playwright": "^4.13.0",
		"@commitlint/cli": "^20.5.3",
		"@commitlint/config-conventional": "^20.5.3",
		"@eslint/js": "^9.39.5",
		"@fontsource-variable/archivo": "^5.3.0",
		"@playwright/test": "^1.62.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^20.17.10",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@wordpress/browserslist-config": "^6.53.0",
		"@wordpress/env": "^11.12.0",
		"@wordpress/interactivity": "^6.53.0",
		"@wordpress/prettier-config": "^4.53.0",
		"@wordpress/scripts": "^34.1.0",
		"@wordpress/stylelint-config": "^24.2.0",
		"concurrently": "^9.2.4",
		"eslint": "^9.39.5",
		"fast-glob": "^3.3.3",
		"husky": "^9.1.7",
		"jest-environment-jsdom": "30.4.1",
		"lint-staged": "^16.2.7",
		"mini-css-extract-plugin": "^2.10.2",
		"prettier": "npm:wp-prettier@^3.0.3",
		"stylelint": "^16.24.0",
		"typescript": "^5.9.3",
		"webpack-merge": "^6.0.1",
		"webpack-remove-empty-scripts": "^1.0.4"
	},
	"scripts": {
		"prepare": "husky",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"env:logs": "wp-env logs",
		"cli": "wp-env run cli wp",
		"build": "rm -rf dist && pnpm build:modules && pnpm build:assets && pnpm build:blocks",
		"build:modules": "wp-scripts build --config webpack.modules.config.mjs",
		"build:assets": "wp-scripts build --config webpack.assets.config.mjs",
		"build:blocks": "wp-scripts build --webpack-src-dir=./src/blocks --output-path=./dist/blocks --experimental-modules",
		"start": "concurrently -k -n modules,assets,blocks -c blue,magenta,green \"pnpm start:modules\" \"pnpm start:assets\" \"pnpm start:blocks\"",
		"start:modules": "wp-scripts start --config webpack.modules.config.mjs",
		"start:assets": "wp-scripts start --config webpack.assets.config.mjs",
		"start:blocks": "wp-scripts start --webpack-src-dir=./src/blocks --output-path=./dist/blocks --experimental-modules",
		"format:fix": "prettier --write \"src/**/*.{js,json,ts,tsx}\" \"tests/e2e/**/*.{js,json,ts,tsx}\" \"bin/**/*.mjs\" \"*.config.{js,mjs,ts}\" package.json tsconfig.json",
		"format:check": "prettier --check \"src/**/*.{js,json,ts,tsx}\" \"tests/e2e/**/*.{js,json,ts,tsx}\" \"bin/**/*.mjs\" \"*.config.{js,mjs,ts}\" package.json tsconfig.json",
		"lint:js": "eslint src --max-warnings 0",
		"lint:js:fix": "eslint src --fix",
		"lint:css": "stylelint \"src/**/*.css\" --max-warnings 0",
		"lint:css:fix": "stylelint \"src/**/*.css\" --fix",
		"lint:commit": "commitlint --edit",
		"typecheck": "tsc --noEmit",
		"test:js": "wp-scripts test-unit-js --config jest.config.js",
		"lint:php": "composer run-script phpcs",
		"lint:php:fix": "composer run-script phpcs:fix",
		"dev:seed": "wp-env run cli --env-cwd=wp-content/plugins/aggressive-ads wp eval 'require \"bin/dev/seed.php\";'",
		"analyse:php": "composer run-script analyse",
		"lint:files": "bash bin/check-file-length.sh && bash bin/ci/check-repository-boundary.sh && bash bin/ci/check-permission-callbacks.sh && bash bin/ci/check-action-pins.sh && bash bin/ci/check-ci-parity.sh",
		"test:php:unit": "vendor/bin/phpunit",
		"test:php:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/aggressive-ads vendor/bin/phpunit -c phpunit-integration.xml.dist",
		"test:php:multisite": "wp-env run tests-cli --env-cwd=wp-content/plugins/aggressive-ads vendor/bin/phpunit -c phpunit-multisite.xml.dist",
		"test:e2e:install": "playwright install --with-deps chromium webkit",
		"test:e2e": "playwright test",
		"ci:doctor": "node bin/ci/doctor.mjs",
		"ci:coverage": "bash bin/ci/run-coverage.sh",
		"ci:security": "node bin/ci/check-patched-dependencies.mjs && composer audit --locked --no-interaction && pnpm audit --audit-level moderate --ignore GHSA-xcpc-8h2w-3j85",
		"ci:build": "pnpm build",
		"composer:verify": "composer validate --strict --no-check-publish && composer install --dry-run --no-interaction --no-scripts",
		"ci:frontend": "pnpm lint:js && pnpm typecheck && pnpm lint:css && pnpm format:check && pnpm test:js",
		"ci:php": "pnpm lint:php && pnpm analyse:php && pnpm test:php:unit",
		"ci:php:wp": "pnpm test:php:integration && pnpm test:php:multisite",
		"ci:e2e": "pnpm test:e2e",
		"release:package": "bash bin/release/package.sh",
		"release:verify": "bash bin/release/verify-package.sh",
		"ci:package": "pnpm release:package && pnpm release:verify",
		"qa": "pnpm ci:verify",
		"qa:fast": "bash bin/ci/verify-fast.sh",
		"precommit": "lint-staged",
		"ci:verify": "bash bin/ci/verify.sh"
	},
	"lint-staged": {
		"src/**/*.{js,ts,tsx}": [
			"prettier --write",
			"eslint --fix"
		],
		"src/**/*.css": "stylelint --fix",
		"tests/e2e/**/*.{js,ts,tsx}": "prettier --write",
		"bin/**/*.mjs": "prettier --write",
		"{package.json,tsconfig.json,*.config.js,*.config.mjs,*.config.ts}": "prettier --write"
	},
	"pnpm": {
		"ignoredBuiltDependencies": [
			"@parcel/watcher",
			"core-js",
			"core-js-pure",
			"unrs-resolver"
		]
	}
}
