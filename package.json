{
	"name": "laao-advertiser-portal",
	"version": "0.1.0",
	"description": "Self-service advertising portal for LAArtsOnline, publishing to AdSanity on approval.",
	"license": "GPL-2.0-or-later",
	"private": true,
	"type": "module",
	"engines": {
		"node": ">=24 <25",
		"pnpm": ">=11 <12"
	},
	"packageManager": "pnpm@11.1.2",
	"browserslist": [
		"extends @wordpress/browserslist-config"
	],
	"devDependencies": {
		"@axe-core/playwright": "^4.12.1",
		"@eslint/js": "^9.39.5",
		"@playwright/test": "^1.62.1",
		"@types/jest": "^30.0.0",
		"@types/node": "^24.0.0",
		"@typescript-eslint/eslint-plugin": "^8.65.0",
		"@typescript-eslint/parser": "^8.65.0",
		"@wordpress/browserslist-config": "^6.52.0",
		"@wordpress/env": "^10.17.0",
		"@wordpress/interactivity": "^6.52.0",
		"@wordpress/scripts": "^33.0.0",
		"@wordpress/stylelint-config": "^24.1.0",
		"concurrently": "^9.2.4",
		"eslint": "^9.39.5",
		"fast-glob": "^3.3.3",
		"jest-environment-jsdom": "30.4.1",
		"mini-css-extract-plugin": "^2.10.2",
		"stylelint": "^16.24.0",
		"typescript": "^5.9.3",
		"webpack-merge": "^6.0.1",
		"webpack-remove-empty-scripts": "^1.0.4"
	},
	"scripts": {
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"env:destroy": "wp-env destroy",
		"env:logs": "wp-env logs",
		"cli": "wp-env run cli wp",
		"build": "rm -rf dist && pnpm build:modules && pnpm build:assets",
		"build:modules": "wp-scripts build --config webpack.modules.config.mjs",
		"build:assets": "wp-scripts build --config webpack.assets.config.mjs",
		"start": "concurrently -k -n modules,assets -c blue,magenta \"pnpm start:modules\" \"pnpm start:assets\"",
		"start:modules": "wp-scripts start --config webpack.modules.config.mjs",
		"start:assets": "wp-scripts start --config webpack.assets.config.mjs",
		"lint:js": "eslint src --max-warnings 0",
		"lint:css": "stylelint \"src/styles/**/*.css\" --max-warnings 0",
		"typecheck": "tsc --noEmit",
		"test:js": "wp-scripts test-unit-js --config jest.config.js",
		"lint:php": "composer run-script phpcs",
		"lint:php:fix": "composer run-script phpcs:fix",
		"dev:seed": "wp-env run cli --env-cwd=wp-content/plugins/laao-advertiser-portal wp eval 'require \"bin/dev/seed.php\";'",
		"analyse:php": "composer run-script analyse",
		"lint:files": "bash bin/check-file-length.sh && bash bin/ci/check-repository-boundary.sh && bash bin/ci/check-permission-callbacks.sh && bash bin/ci/check-action-pins.sh && bash bin/ci/check-ci-parity.sh",
		"test:php:unit": "vendor/bin/phpunit",
		"test:php:integration": "wp-env run tests-cli --env-cwd=wp-content/plugins/laao-advertiser-portal vendor/bin/phpunit -c phpunit-integration.xml.dist",
		"test:e2e:install": "playwright install chromium",
		"test:e2e": "playwright test",
		"ci:doctor": "node bin/ci/doctor.mjs",
		"ci:build": "pnpm build",
		"ci:frontend": "pnpm lint:js && pnpm typecheck && pnpm lint:css && pnpm test:js",
		"ci:php": "pnpm lint:php && pnpm analyse:php && pnpm test:php:unit",
		"ci:php:wp": "pnpm test:php:integration",
		"ci:e2e": "pnpm build && pnpm test:e2e",
		"release:package": "bash bin/release/package.sh",
		"release:verify": "bash bin/release/verify-package.sh",
		"ci:package": "pnpm build && pnpm release:package && pnpm release:verify",
		"qa": "pnpm ci:php && pnpm lint:files",
		"ci:verify": "bash bin/ci/verify.sh"
	}
}
